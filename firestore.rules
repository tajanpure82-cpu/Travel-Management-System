rules_version = '2';

// Hardened from the Phase 1 baseline now that every collection's real
// shape is known. Explicit per-collection matches instead of one
// wildcard — anything NOT listed here is denied by default. Still "any
// signed-in user, full access" within those bounds — this is a shared
// trip dashboard for a closed group, not a multi-tenant product.
//
// settlementPayments added here (new collection, for recorded "who
// actually paid whom" settlement records) — without an explicit rule for
// it, it would be denied by default under this same policy, and the
// Mark as Paid feature would silently fail with permission-denied.
service cloud.firestore {
  match /databases/{database}/documents {

    match /travellers/{docId} {
      allow read, write: if request.auth != null;
    }

    match /vehicles/{docId} {
      allow read, write: if request.auth != null;
    }

    match /expenses/{docId} {
      allow read, write: if request.auth != null;
    }

    match /fuelEntries/{docId} {
      allow read, write: if request.auth != null;
    }

    match /tolls/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hotelBookings/{docId} {
      allow read, write: if request.auth != null;
    }

    match /documents/{docId} {
      allow read, write: if request.auth != null;
    }

    match /checklistItems/{docId} {
      allow read, write: if request.auth != null;
    }

    match /emergencyContacts/{docId} {
      allow read, write: if request.auth != null;
    }

    match /timelineEntries/{docId} {
      allow read, write: if request.auth != null;
    }

    match /settlementPayments/{docId} {
      allow read, write: if request.auth != null;
    }

    // Singleton — only settings/trip may ever exist.
    match /settings/{settingsId} {
      allow read, write: if request.auth != null && settingsId == "trip";
    }
  }
}
